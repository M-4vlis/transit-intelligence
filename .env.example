# Local development only. Use secret management in staging/production.
POSTGRES_PASSWORD=change-me-for-local-dev
RIO_REALTIME_URL=https://dados.mobilidade.rio/gps/sppo
RIO_POLL_INTERVAL_SECONDS=60
RIO_REALTIME_INITIAL_WINDOW_SECONDS=120
RIO_REALTIME_OVERLAP_SECONDS=30
RIO_REALTIME_MAX_WINDOW_SECONDS=300
RIO_REALTIME_MAX_RESPONSE_BYTES=33554432
RIO_GTFS_URL=https://dados.mobilidade.rio/gtfs/schedule
GTFS_MAX_COMPRESSED_BYTES=67108864
GTFS_MAX_UNCOMPRESSED_BYTES=536870912
GTFS_MAX_MEMBERS=128
# Cold archive (local is development-only; destructive retention remains disabled)
ARCHIVE_STORAGE_KIND=local
ARCHIVE_LOCAL_ROOT=/data/archive
ARCHIVE_BATCH_SIZE=50000
DESTRUCTIVE_RETENTION_ENABLED=false

# Production cold archive example (OCI S3-compatible / R2). Never commit real secrets.
# ARCHIVE_STORAGE_KIND=oci-s3
# ARCHIVE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oci.customer-oci.com
# ARCHIVE_S3_REGION=<region>
# ARCHIVE_S3_BUCKET=<bucket>
# ARCHIVE_S3_ACCESS_KEY_ID=<secret-manager-or-env>
# ARCHIVE_S3_SECRET_ACCESS_KEY=<secret-manager-or-env>
# ARCHIVE_S3_PREFIX=transit-history
