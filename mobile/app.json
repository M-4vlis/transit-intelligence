{
  "expo": {
    "name": "Transit Intelligence",
    "slug": "transit-intelligence",
    "version": "0.1.3",
    "orientation": "portrait",
    "scheme": "transitintelligence",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.transitintelligence.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.transitintelligence.mobile",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o Transit Intelligence use sua localização para centralizar o mapa e mostrar o transporte próximo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
