# Copy to .env.production on the VPS and chmod 600. NEVER COMMIT THE REAL FILE.
POSTGRES_PASSWORD=replace-with-at-least-24-random-characters
CACHE_PASSWORD=replace-with-at-least-24-random-characters

# Host-only port. The container still listens on 8000.
TRANSIT_API_HOST_PORT=18000

# M1 public edge. The token itself lives only in this root-readable file.
PUBLIC_API_HOSTNAME=api.example.com
CLOUDFLARE_TUNNEL_TOKEN_FILE=/home/ubuntu/apps/transit-intelligence/.secrets/cloudflare-tunnel-token
CORS_ALLOWED_ORIGINS=

RIO_REALTIME_URL=https://dados.mobilidade.rio/gps/sppo
RIO_POLL_INTERVAL_SECONDS=60
RIO_REALTIME_INITIAL_WINDOW_SECONDS=120
RIO_REALTIME_OVERLAP_SECONDS=30
RIO_REALTIME_MAX_WINDOW_SECONDS=300
RIO_REALTIME_MAX_RESPONSE_BYTES=33554432
SOURCE_TIMEOUT_SECONDS=20
LIVE_POSITION_TTL_SECONDS=180

# Official monthly static schedule/network feed. Download is allowlisted and bounded.
RIO_GTFS_URL=https://www.arcgis.com/sharing/rest/content/items/8ffe62ad3b2f42e49814bf941654ea6c/data
GTFS_MAX_COMPRESSED_BYTES=67108864
GTFS_MAX_UNCOMPRESSED_BYTES=536870912
GTFS_MAX_MEMBERS=128

# Start the 24h soak with retention disabled.
HOT_RETENTION_DAYS=2
DESTRUCTIVE_RETENTION_ENABLED=false

# Local archive is acceptable during initial soak because nothing is deleted.
# Before enabling destructive retention, switch to oci-s3 or r2 and validate restore.
ARCHIVE_STORAGE_KIND=local
ARCHIVE_LOCAL_ROOT=/data/archive
ARCHIVE_BATCH_SIZE=50000
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_PREFIX=transit-history
