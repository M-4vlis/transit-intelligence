[Unit]
Description=Restore and verify latest Transit Intelligence M2 confidence evidence
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/transit-intelligence
ExecStart=/bin/bash infra/scripts/restore_eta_confidence_evidence.sh
TimeoutStartSec=15min
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
