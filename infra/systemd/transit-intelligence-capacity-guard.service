[Unit]
Description=Protect the shared VPS from Transit Intelligence capacity exhaustion
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/home/ubuntu/apps/transit-intelligence/.env.production

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/transit-intelligence
ExecStart=/bin/bash infra/scripts/guard_transit_capacity.sh
TimeoutStartSec=3h
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
